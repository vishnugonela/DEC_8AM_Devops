#!/bin/bash

# Step 1: Define how many containers you want
COUNT=10

# Step 2: Define image name
IMAGE="nginx"

# Step 3: Loop from 1 to 10
for i in $(seq 1 $COUNT)
do
    CONTAINER_NAME="mycontainer_$i"

    echo "Checking $CONTAINER_NAME ..."

    # Step 4: Check if container already exists
    if docker ps -a --format '{{.Names}}' | grep -w $CONTAINER_NAME > /dev/null 2>&1
    then
        echo "$CONTAINER_NAME exists. Deleting..."

        # Stop container (if running)
        docker stop $CONTAINER_NAME > /dev/null 2>&1

        # Remove container
        docker rm $CONTAINER_NAME
    fi

    # Step 5: Create new container
    docker run -d --name $CONTAINER_NAME $IMAGE

    echo "$CONTAINER_NAME created successfully"
    echo "-------------------------------"
done

echo "All 10 containers created."
