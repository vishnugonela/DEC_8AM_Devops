// Write a docker file to create image build with your container login via ssh with root login. 

FROM ubuntu:20.04

RUN apt-get update && \
    apt-get install -y openssh-server && \
    mkdir /var/run/sshd

RUN echo 'root:root123' | chpasswd

RUN sed -i 's/PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D"]


Build the Image

docker build -t ssh-container .


Run the container

docker run -d -p 2222:22 --name ssh-test ssh-container


Then try logging into ssh
