pipeline {
    agent any

    stages {

        stage("Build") {
            steps {
                sh '''
                echo "Server details are :"
                echo "Hostname : $(hostname)"
                echo "Kernel details:"
                uname -a
                echo "IP Address : $(hostname -I)"
                echo "OS Details :"
                cat /etc/os-release
                echo "CPU details :"
                lscpu
                echo "Disk space:"
                df -h
                '''
            }
        }

        stage("Test") {
            steps {
                sh '''
                echo "Test application..."
                '''
            }
        }

    }
}
