pipeline {
    agent any

    environment {
        BACKUP_DIR = "/var/backups/jenkins"
        JENKINS_HOME_DIR = "/var/lib/jenkins"
    }

    stages {
        stage('Backup Jenkins Home') {
            steps {
                script {
                    def timestamp = new Date().format('yyyyMMdd-HHmmss')
                    def backupFile = "${BACKUP_DIR}/jenkins-backup-${timestamp}.tar.gz"

                    echo "=== Starting Jenkins Backup ==="

                    sh "mkdir -p ${BACKUP_DIR}"
                    sh "tar -czf ${backupFile} ${JENKINS_HOME_DIR}"

                    echo "✅ Backup completed successfully!"
                    echo "Backup file: ${backupFile}"
                }
            }
        }
    }
}
